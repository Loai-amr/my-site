# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# ─── Site ─────────────────────────────────────────────────────────────────────
# Optional. Public base URL, no trailing slash, e.g. https://www.loaiamr.com. Used for canonical
# links, the sitemap, RSS and JSON-LD. Falls back to NEXT_PUBLIC_SITE_URL, then to Vercel's
# production URL, so it can stay empty on Vercel.
SITE_URL=

# ─── Supabase (Project Settings → API) ────────────────────────────────────────
# The same project as shop.loaiamr.com. Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" public key (or "publishable" key, sb_publishable_...). RLS lets it read published posts only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key (or "secret" key, sb_secret_...). SERVER ONLY, never expose it.
# Bypasses RLS: blog writes and the draft list go through it.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Blog ─────────────────────────────────────────────────────────────────────
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`). The daily blog automation sends it
# as "Authorization: Bearer <value>" to /api/blog/publish and /api/blog/titles. Shorter or empty = 401.
BLOG_PUBLISH_SECRET=
# false (default): posts from the API arrive as drafts; review and publish them in /admin/blog.
# true: the API publishes immediately (unless the request asks for "status": "draft").
BLOG_AUTO_PUBLISH=false
# Password for /admin/blog, at least 12 characters. Shorter or empty = nobody can sign in.
BLOG_ADMIN_PASSWORD=
